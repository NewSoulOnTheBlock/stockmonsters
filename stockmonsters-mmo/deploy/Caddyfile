# Stockmonsters MMO, behind Caddy.
#
# Installed to /etc/caddy/Caddyfile by deploy/bootstrap.sh, with {$SM_DOMAIN}
# supplied from the environment. Caddy runs on the host here rather than in a
# container: the game server is a plain host process on :3000, and a
# containerised proxy would have to reach back out through host.docker.internal
# for no benefit.
#
# Caddy provisions and renews the certificate on its own. Nothing about TLS is
# configured below because nothing needs to be.

{$SM_DOMAIN} {
	# WEBSOCKETS ARE THE WHOLE GAME.
	#
	# The RPGJS transport lives under /parties and every connected player holds
	# one open socket for their entire session. Caddy v2 handles the upgrade
	# natively — there is no nginx-style Upgrade header dance to write — but the
	# default read timeout would drop a player who stands still, so it is
	# raised. A player reading their inventory sends nothing for minutes.
	reverse_proxy localhost:3000 {
		transport http {
			read_timeout 24h
			write_timeout 24h
		}
	}

	# ONLY FINGERPRINTED PATHS MAY BE IMMUTABLE.
	#
	# Vite hashes everything under /assets, so those names change whenever the
	# bytes do and caching them forever is free. /map/ is NOT hashed — the
	# atlases and maps have stable names like exterior.png — so marking them
	# immutable told every returning browser to keep the old art for a year and
	# not even ask. On the day the atlases were repacked that would serve a stale
	# tileset against fresh map data, which draws nothing — and a reload would
	# not clear it, because that is what immutable means.
	#
	# Whether it is what broke a player's game that day was never established;
	# it is wrong either way, and it is exactly the shape of that failure.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Stable names, changing contents: cache them, but always revalidate. A
	# conditional request that comes back 304 costs one round trip and cannot
	# serve the wrong art.
	@revalidate path /map/* /spritesheets/* /dex/* /previews/* /titles/* /audio/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	# index.html and the API must never be cached: the first carries the script
	# tags that point at those fingerprinted files, and a stale copy pins a
	# player to a build that no longer exists.
	@nocache path / /index.html /token* /box/* /market* /market/* /auth/* /rewards/* /health
	header @nocache Cache-Control "no-store"

	encode zstd gzip

	log {
		output file /var/log/caddy/stockmonsters.log
		format console
	}
}
