{
  "name": "myrpg",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:production": "node --test test/production-preview.test.mjs",
    "build:mmo": "RPG_TYPE=mmorpg vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env db/migrate.mjs --status",
    "db:reset": "node --env-file-if-exists=.env db/migrate.mjs --reset",
    "db:psql": "docker compose exec postgres psql -U stockmonsters -d stockmonsters",
    "test:profiles": "node --env-file-if-exists=.env --test test/profiles.test.mjs",
    "test:friends": "node --env-file-if-exists=.env --test test/friends.test.mjs",
    "test:e2e:persistence": "node --env-file-if-exists=.env tools/e2e-persistence.mjs",
    "test:e2e:friends": "node --env-file-if-exists=.env tools/e2e-friends.mjs",
    "test:e2e:token": "node --env-file-if-exists=.env tools/e2e-token.mjs",
    "test:e2e:duel": "node --env-file-if-exists=.env tools/e2e-duel.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@canvasengine/compiler": "2.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.6",
    "path-browserify": "^1.0.1",
    "puppeteer-core": "^24.43.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "dependencies": {
    "@canvasengine/presets": "2.2.0",
    "@rpgjs/action-battle": "5.0.0-beta.33",
    "@rpgjs/client": "5.0.0-beta.33",
    "@rpgjs/common": "5.0.0-beta.30",
    "@rpgjs/server": "5.0.0-beta.33",
    "@rpgjs/tiledmap": "5.0.0-beta.33",
    "@rpgjs/ui-css": "5.0.0-beta.26",
    "@rpgjs/vite": "5.0.0-beta.33",
    "@signe/di": "^3.1.1",
    "canvasengine": "2.2.0",
    "pg": "^8.23.0",
    "pixi.js": "^8.19.0",
    "sharp": "^0.35.3",
    "viem": "^2.55.19"
  },
  "type": "module"
}
