# Copy to .env and edit. .env is gitignored; this file must never hold a real
# secret.
#
#   cp .env.example .env
#   docker compose up -d
#   npm run db:migrate
#   npm run build:mmo && npm start

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# HMAC key behind the player id:  connectionId = "w:" + HMAC-SHA256(SECRET, address)
#
# !! THIS IS THE PRIMARY KEY OF EVERY SAVE. !!
# Change it and every wallet hashes to a new id: existing players connect as
# brand-new characters and their party, box, bag, name and look are orphaned in
# the database (not deleted — just unreachable). Treat it like a database
# password: generate once, back it up, never rotate casually.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Unset in development means a random one per boot, i.e. saves reset on every
# restart. auth.mjs warns when that happens.
SERVER_SECRET=change-me-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Postgres (docker compose up -d)
# ---------------------------------------------------------------------------
POSTGRES_USER=stockmonsters
POSTGRES_PASSWORD=stockmonsters
POSTGRES_DB=stockmonsters
# Host-side port. Non-default on purpose so the container cannot collide with a
# Postgres already running on this machine.
POSTGRES_PORT=5433

# The one variable the server actually reads. UNSET IT and the game still runs
# — profiles silently fall back to in-memory, per-session state, exactly as it
# behaved before persistence existed (one warning line, no crash).
DATABASE_URL=postgres://stockmonsters:stockmonsters@localhost:5433/stockmonsters

# Optional pool tuning. Defaults are fine for one Node process.
# PGPOOL_MAX=10

# How long the store batches a player's writes before flushing, milliseconds.
# Every variable change marks the profile dirty; only this timer writes.
# PROFILE_FLUSH_MS=1500

# ---------------------------------------------------------------------------
# Redis — running but UNUSED. See docs/persistence.md.
# ---------------------------------------------------------------------------
REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# The game token and the economy  (contracts/ + docs/token-economy.md)
# ---------------------------------------------------------------------------
# ONE ADDRESS SWITCHES THE CURRENCY ON. Name, symbol, decimals and logo are
# read off the token itself — it describes itself on chain — so nothing in the
# codebase hardcodes a symbol and swapping in a different launch token later is
# this one variable.
#
# UNSET is a supported state: prices stay in ETH, the balance chip disappears
# rather than showing a fake number, and the box shop keeps its DEMO MODE
# banner. Exactly the pre-token behaviour, and the UI says so.
SM_TOKEN_ADDRESS=
SM_CHAIN_ID=11155111
SM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The rest of the deployment. tools/deploy.mjs writes all of these for you.
SM_REWARDS_ADDRESS=
SM_TREASURY_ADDRESS=
SM_MARKET_ADDRESS=

# The UTC day the rewards contract was deployed, as a day number
# (Math.floor(Date.now() / 86400000)). Reward epochs are one day each and count
# from here, so the first day of the game is epoch 1.
#
# !! DO NOT CHANGE IT AFTER LAUNCH. !! Every epoch renumbers, and today's
# claims start pointing at a budget that belongs to a different day — which
# fails in the confusing direction: valid signatures, empty budget.
SM_EPOCH_DAY0=

# Signs reward claims. NOT the same key as BOX_SIGNER_PK, deliberately: one
# leak should not be both. Generated by tools/deploy.mjs if absent.
# A leaked key can drain at most ONE epoch's budget — that bound is the whole
# reason the rewards contract has per-epoch budgets.
REWARDS_SIGNER_PK=

# Pins the NFT art to IPFS. Only tools/ipfs.mjs reads it; the game server never
# does. Pinata → API Keys → New Key (needs pinFileToIPFS) → copy the JWT.
# It is the JWT that is wanted here, not the "API Key"/"API Secret" pair.
PINATA_JWT=

# OPTIONAL, and not needed for anything to work. What goes on chain is
# ipfs://<cid>/… and wallets resolve that themselves. This is used only to
# spot-check, right after uploading, that the art is really retrievable.
# Your dedicated gateway host, e.g. maroon-hawk-1234.mypinata.cloud.
# Unset falls back to public gateways.
PINATA_GATEWAY=

# --- the loot box / NFT half of the chain config -------------------------
# Written by tools/deploy.mjs. Kept separate from the SM_* block above because
# the box store predates the token store — but they MUST agree on the chain:
# server.mjs warns at boot if BOX_CHAIN_ID and SM_CHAIN_ID differ, because the
# client switches the wallet to SM_CHAIN_ID and a voucher signed for another
# chain then fails with a signature error that blames the signature.
BOX_CHAIN_ID=
BOX_NFT_ADDRESS=
# Signs mint vouchers. A THIRD key, separate from REWARDS_SIGNER_PK and
# BATTLE_SIGNER_PK: three concerns, three blast radii.
BOX_SIGNER_PK=

# Reads Minted/Opened events back off the chain. WITHOUT THIS the game never
# learns a box's token id, which silently breaks opening a box and leaves the
# duel fighter list permanently empty — the box mint itself still lands.
BOX_RPC_URL=
# The NFT's deployment block. Left at the default 0, every sync asks the RPC
# for the entire history of the chain and is refused.
BOX_FROM_BLOCK=

# --- the player-to-player marketplace (market.mjs) ------------------------
# The order book needs no key and holds no custody: a listing is a signature
# the SELLER makes, and the buyer pays for the one transaction that settles it.
# It switches on from SM_MARKET_ADDRESS + BOX_NFT_ADDRESS + SM_RPC_URL +
# SM_CHAIN_ID, all set above. Unset any of them and /market/listings answers
# { configured: false } and the game shows a catalogue clearly marked DEMO MODE.
#
# THE MARKET'S DEPLOYMENT BLOCK. Same trap as BOX_FROM_BLOCK: left at 0 every
# fill scan asks a public RPC for the whole history of the chain and is
# refused — which leaves FILLED ORDERS SITTING IN THE BOOK, and every buyer
# after one of those pays gas to revert. Falls back to BOX_FROM_BLOCK when
# unset, because the two contracts were deployed together.
MARKET_FROM_BLOCK=

# Optional. Its own RPC, if you want the order book off the same endpoint the
# rest of the game uses. Defaults to SM_RPC_URL.
# MARKET_RPC_URL=

# Optional tuning, all with working defaults:
#   MARKET_SYNC_MS=20000        how often the fill/cancel indexer runs
#   MARKET_LOG_SPAN=9000        blocks per getLogs call; public RPCs cap this
#   MARKET_RECHECK_MS=30000     how long a verified listing is trusted before
#                               the read path re-checks it against the chain
#   MARKET_RECHECK_MAX=24       rows re-checked per read, so browsing a busy
#                               book cannot turn into an RPC flood
#   MARKET_MAX_TTL_S=7776000    longest deadline a listing may be signed for
#                               (90 days) — an endless signature is a standing
#                               approval nobody remembers giving
#   MARKET_MAX_PER_SELLER=100   live listings one wallet may hold

# Signs duel and gym battle outcomes. A THIRD key, separate from
# BOX_SIGNER_PK and REWARDS_SIGNER_PK: three concerns, three blast radii.
# Generated by tools/deploy.mjs if absent. A leak of this one can move at most
# maxWager per match and dailyPayoutCap per day — those bounds exist for
# exactly this reason.
BATTLE_SIGNER_PK=

# The blind-pick duel escrow. Written by tools/deploy.mjs.
SM_ARENA_ADDRESS=
# Player-held gyms. DEPLOYED BUT NOT WIRED TO THE GAME — the address is read
# and echoed at /token and nothing else uses it. See docs/token-economy.md.
SM_GYMS_ADDRESS=

# The domain pointing at this box. Read by deploy/bootstrap.sh, which hands it
# to Caddy; Caddy provisions the certificate from it. Only needed in
# production — leave it empty for local development.
SM_DOMAIN=

# --- what a dollar is worth ------------------------------------------------
# Quests are priced in dollars ($1–2 each) and loot boxes are anchored to their
# ether price, so this rate decides what players actually pay and earn.
#
# !! THESE TWO ARE NOW THE FALLBACK, NOT THE SOURCE. !!
#
# The price is READ off the live market by price-oracle.mjs: the Uniswap v4
# pool on Robinhood Chain (chain 4663) that a pons launch graduates into, or
# its bonding curve before it graduates, times an ETH/USD rate from a public
# API. `GET /token/price` says which. See docs/token-economy.md, "What a dollar
# is worth".
#
# They used to be the source, and they were wrong in the direction that does
# not throw: pons lets its bonding curve open the price, and paying "5,000
# tokens for a $1 quest" against a real price a fraction of the assumed one
# underpays every player and logs nothing.
#
# WHAT THEY ARE FOR NOW: the RPC is unreachable, or the token has not launched.
# Then this value is used and the server says so on every boot. It is a number
# a person wrote, so it is a decision, not a guess — which is why it is allowed
# to price a payout at all. With NO value here and no readable market, the
# server REFUSES to quote: quests pay nothing and boxes cannot be bought with
# tokens, rather than paying from an assumption the market has contradicted.
#
# THINK IN MARKET CAP. Supply is a fixed 1,000,000,000, so the price is just
# the valuation divided by it: $200k -> 0.0002, $1M -> 0.001, $10M -> 0.01.
# Set it to the real opening price after launch, not to the old assumption.
#
# Getting one wrong is bounded, not fatal: a CONFIGURED payout is clamped to a
# band 20x either side of the $200k default. A LIVE price is not run through
# that band — its anchor would be the assumption the market disproved — it is
# bounded by a sanity check on the implied market cap, a two-read confirmation
# before any 25x jump is believed, and DAILY_CAP_USD, which is itself in
# dollars.
SM_TOKEN_USD=0.0002
SM_ETH_USD=3000

# The token whose pool is read for that live price. Defaults to
# SM_TOKEN_ADDRESS, but ONLY when SM_CHAIN_ID is the pons chain (4663) —
# otherwise the pons factory would be asked about a Sepolia address and answer
# confidently and emptily. Set this explicitly to price a token before the rest
# of the game has moved chains, or to point the probe at somebody else's
# launch.
# SM_PRICE_TOKEN_ADDRESS=

# Overrides for the pons deployment, all with working defaults in
# price-oracle.mjs. Only needed against a fork or if pons redeploys.
# SM_PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# SM_PONS_CHAIN_ID=4663
# SM_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# SM_PONS_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
# SM_PONS_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
