# Copy to .env and edit. .env is gitignored; this file must never hold a real
# secret.
#
#   cp .env.example .env
#   docker compose up -d
#   npm run db:migrate
#   npm run build:mmo && npm start

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# HMAC key behind the player id:  connectionId = "w:" + HMAC-SHA256(SECRET, address)
#
# !! THIS IS THE PRIMARY KEY OF EVERY SAVE. !!
# Change it and every wallet hashes to a new id: existing players connect as
# brand-new characters and their party, box, bag, name and look are orphaned in
# the database (not deleted — just unreachable). Treat it like a database
# password: generate once, back it up, never rotate casually.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Unset in development means a random one per boot, i.e. saves reset on every
# restart. auth.mjs warns when that happens.
SERVER_SECRET=change-me-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Postgres (docker compose up -d)
# ---------------------------------------------------------------------------
POSTGRES_USER=stockmonsters
POSTGRES_PASSWORD=stockmonsters
POSTGRES_DB=stockmonsters
# Host-side port. Non-default on purpose so the container cannot collide with a
# Postgres already running on this machine.
POSTGRES_PORT=5433

# The one variable the server actually reads. UNSET IT and the game still runs
# — profiles silently fall back to in-memory, per-session state, exactly as it
# behaved before persistence existed (one warning line, no crash).
DATABASE_URL=postgres://stockmonsters:stockmonsters@localhost:5433/stockmonsters

# Optional pool tuning. Defaults are fine for one Node process.
# PGPOOL_MAX=10

# How long the store batches a player's writes before flushing, milliseconds.
# Every variable change marks the profile dirty; only this timer writes.
# PROFILE_FLUSH_MS=1500

# ---------------------------------------------------------------------------
# Redis — running but UNUSED. See docs/persistence.md.
# ---------------------------------------------------------------------------
REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
