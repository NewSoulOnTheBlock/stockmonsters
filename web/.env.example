# Copy to .env and fill in before `docker compose up`.

# The server's PUBLIC IP address. WebRTC cannot connect without it.
# On the box:  curl -s ifconfig.me
PUBLIC_IP=

# Password players need to enter. Leave as-is for an open demo; the neko
# login page still asks for it, so put it on your landing page.
PLAYER_PASSWORD=stonks

# Admin password — keep this secret. Admins can take control, kick players
# and reset the session.
ADMIN_PASSWORD=

# UDP port range for WebRTC media. Must be open in your firewall.
WEBRTC_PORTS=52000-52100

# Game language: en, fr, it, de, es, ko, kana
GAME_LANG=en

# A domain pointing at this box, e.g. play.stockmonsters.xyz. Set it and start
# with `--profile tls` to get HTTPS via Caddy. Leave empty to serve plain http
# on :8080 — fine for testing, but browsers restrict WebRTC on plain http, so
# set this before sharing the link publicly.
GAME_DOMAIN=
